# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Secrets loading (scripts/start-with-secrets.ts) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Data stores ---
DATABASE_URL=postgresql://app:app@localhost:5441/api_platform
REDIS_URL=redis://localhost:6380/0

# --- Admin ---
# Bearer token for /v1/admin/*. Use a long random value.
ADMIN_API_KEY=change-me-to-a-long-random-admin-key-32-chars-min

# --- Links ---
# Base URL used to build each link's shortUrl.
PUBLIC_BASE_URL=http://localhost:3000
# How long a redirect lookup stays in the Redis cache.
REDIRECT_CACHE_TTL_SECONDS=300
